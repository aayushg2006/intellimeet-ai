# ─────────────────────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ─────────────────────────────────────────────────────────────

PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/intellimeet
JWT_SECRET=generate_a_long_random_string_here

# Where the frontend lives. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:5173

# Set to "production" on the deployed instance. Anything other than
# "development" enables strict CORS and hides stack traces from responses.
NODE_ENV=development


# ─────────────────────────────────────────────────────────────
# AI — required for summaries, semantic search and the live copilot
# ─────────────────────────────────────────────────────────────

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# EMBEDDING_MODEL=text-embedding-004
# SEMANTIC_SEARCH_ENABLED=true
# COPILOT_ENABLED=true
# COPILOT_MAX_RUNS_PER_MEETING=40
# COPILOT_MAX_MEETING_MINUTES=120


# ─────────────────────────────────────────────────────────────
# FILE STORAGE — required for avatars, attachments and recordings
# ─────────────────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=


# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH — optional; email/password login works without it
# ─────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ─────────────────────────────────────────────────────────────
# TURN RELAY — strongly recommended
#
# WebRTC uses public STUN servers by default, which cannot relay media. Two
# peers behind symmetric NAT (most corporate networks, many mobile carriers)
# will silently fail to connect without a TURN server.
#
# Free tier: https://www.metered.ca/tools/openrelay/ (50GB/month)
# Comma-separate the URLs to provide both UDP and TCP/TLS endpoints.
# ─────────────────────────────────────────────────────────────

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=


# ─────────────────────────────────────────────────────────────
# EMAIL — optional, but password reset cannot complete without it
#
# With no key set, reset tokens are returned in the API response so the flow
# stays testable locally. In production that fallback is disabled, so users
# would have no way to receive their reset link.
#
# Free tier: https://resend.com
# ─────────────────────────────────────────────────────────────

RESEND_API_KEY=
EMAIL_FROM=IntellMeet <onboarding@resend.dev>


# ─────────────────────────────────────────────────────────────
# REDIS — entirely optional
#
# Without it, meeting state lives in process memory (fine for a single
# instance) and is lost on restart. With it, state is shared and the app can
# run more than one instance behind a load balancer.
# ─────────────────────────────────────────────────────────────

# REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false


# ─────────────────────────────────────────────────────────────
# TUNING — optional
# ─────────────────────────────────────────────────────────────

# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_DAYS=30
# RATE_LIMIT_PER_MINUTE=300
# VECTOR_INDEX_NAME=chunk_embedding_index
